{
  "id": "proposal-story",
  "name": "企画書ストーリー設計",
  "description": "テーマから複数ストーリー案を作り、比較評価して企画書構成へ変換する",
  "version": "1.0.0",
  "input": "inputs/user-theme.json",
  "agent_order": "config/agent-order.json",
  "command": "commands/run-proposal-story.md",
  "output_dir": "outputs/proposal-story",
  "outputs": [
    "run_manifest.json",
    "00_orchestrator.json",
    "01_theme_interpreter.json",
    "02_environment_research.json",
    "03_issue_objective.json",
    "04_story_generator.json",
    "05_solution_generator.json",
    "06_evidence_research.json",
    "07_evaluation.json",
    "08_recommendation.json",
    "09_deck_outline.json",
    "10_validation.json",
    "final_report.md",
    "proposal_story_analysis.xlsx",
    "selected_story_review.md"
  ]
}
