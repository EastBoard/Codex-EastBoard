{
  "template_id": "proposal-story",
  "phases": [
    {
      "id": "analysis",
      "name": "企画書設計・Excel出力",
      "description": "テーマ解釈、調査観点、複数ストーリー案、比較評価、推奨案、章構造、Excel管理表までを生成する。",
      "requires_confirmation": false,
      "command": "npm run analysis:proposal-story",
      "outputs": [
        "run_manifest.json",
        "web_research_plan.json",
        "web_research_results.json",
        "06_evidence_research.json",
        "final_report.md",
        "proposal_story_analysis.xlsx",
        "selected_story_review.md",
        "approval_request.json",
        "agent_prompt_chain.json",
        "layout_registry.csv",
        "final_slide_plan.json"
      ]
    },
    {
      "id": "slides",
      "name": "スライド作成・PowerPoint出力",
      "description": "分析フェーズのスライドJSONをもとに、指定PPTXデザインでPowerPointを生成する。",
      "requires_confirmation": true,
      "confirmation_question": "Excel確認後、承認済みとしてスライド作成まで進めますか？",
      "command": "npm run continue -- <analysis_run_dir>",
      "outputs": [
        "approval_decision.json",
        "22_powerpoint_exporter.json",
        "proposal_story_slides.pptx"
      ]
    }
  ]
}
